# === Telegram Bot ===
BOT_TOKEN=

# === LLM Providers ===
# Поддерживаемые: groq, anthropic, openai
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.3

# Groq (бесплатный) — console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI — platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# === Admin ===
ADMIN_IDS=[123456789]

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./mindlint.db

# === Logging ===
LOG_LEVEL=INFO
